---
// Masonry gallery + lightbox. Used for research photos and photography.
export interface GalleryItem {
  thumb: string;
  full: string;
  w: number;
  h: number;
  caption: string;
  tag?: string;
  href?: string; // optional external link shown in the lightbox (e.g. Flickr page)
}
interface Props { items: GalleryItem[]; id: string; linkLabel?: string }
const { items, id, linkLabel = 'View on Flickr' } = Astro.props;
---
<div class="gallery" data-gallery={id}>
  {items.map((it, i) => (
    <figure class="g-item reveal">
      <button type="button" class="g-btn" data-index={i} aria-label={`Open photo: ${it.caption}`}>
        <img src={it.thumb} alt={it.caption} width={it.w} height={it.h} loading="lazy" decoding="async" />
        <span class="g-cap">{it.tag && <span class="g-tag mono">{it.tag}</span>}{it.caption}</span>
      </button>
    </figure>
  ))}
</div>

<dialog class="lightbox" id={`lb-${id}`} aria-label="Photo viewer">
  <button class="lb-close" type="button" aria-label="Close">×</button>
  <button class="lb-nav lb-prev" type="button" aria-label="Previous photo">‹</button>
  <figure>
    <img class="lb-img" alt="" />
    <figcaption>
      <span class="lb-cap"></span>
      <span class="lb-meta mono"><span class="lb-count"></span><a class="lb-link" target="_blank" rel="noopener" hidden>{linkLabel} ↗</a></span>
    </figcaption>
  </figure>
  <button class="lb-nav lb-next" type="button" aria-label="Next photo">›</button>
</dialog>

<script is:inline define:vars={{ items, id }}>
  (() => {
    const root = document.querySelector(`[data-gallery="${id}"]`);
    const dlg = document.getElementById(`lb-${id}`);
    if (!root || !dlg) return;
    const img = dlg.querySelector('.lb-img'), cap = dlg.querySelector('.lb-cap'), cnt = dlg.querySelector('.lb-count'), link = dlg.querySelector('.lb-link');
    let cur = 0;
    const show = (i) => {
      cur = (i + items.length) % items.length;
      const it = items[cur];
      img.src = it.full; img.alt = it.caption; cap.textContent = it.caption;
      cnt.textContent = `${cur + 1} / ${items.length}`;
      if (it.href) { link.href = it.href; link.hidden = false; } else link.hidden = true;
    };
    root.addEventListener('click', (e) => { const b = e.target.closest('.g-btn'); if (!b) return; show(+b.dataset.index); dlg.showModal(); });
    dlg.querySelector('.lb-close').onclick = () => dlg.close();
    dlg.querySelector('.lb-prev').onclick = () => show(cur - 1);
    dlg.querySelector('.lb-next').onclick = () => show(cur + 1);
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(cur - 1); if (e.key === 'ArrowRight') show(cur + 1); });
    let x0 = null;
    dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => { if (x0 === null) return; const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) show(cur + (dx < 0 ? 1 : -1)); x0 = null; });
  })();
</script>

<style>
  .gallery { columns: 3 280px; column-gap: 14px; }
  .g-item { margin: 0 0 14px; break-inside: avoid; }
  .g-btn { all: unset; cursor: zoom-in; display: block; position: relative; border-radius: 14px; overflow: hidden; border: 1px solid var(--border); background: var(--bg-2); width: 100%; }
  .g-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .g-btn img { width: 100%; height: auto; transition: transform 0.6s cubic-bezier(.2,.7,.2,1), filter 0.4s; }
  .g-cap { position: absolute; inset: auto 0 0 0; padding: 36px 14px 12px; font-size: 0.85rem; line-height: 1.4; color: #eef5f0; background: linear-gradient(to top, rgba(4, 10, 7, 0.85), transparent); opacity: 0; transform: translateY(6px); transition: all 0.35s; }
  .g-tag { display: block; font-size: 0.66rem; letter-spacing: .1em; text-transform: uppercase; color: #6ff5a6; margin-bottom: 3px; }
  .g-btn:hover img { transform: scale(1.04); }
  .g-btn:hover .g-cap, .g-btn:focus-visible .g-cap { opacity: 1; transform: none; }
  @media (hover: none) { .g-cap { opacity: 1; transform: none; } }

  .lightbox { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; color: #eef5f0; }
  .lightbox::backdrop { background: rgba(3, 7, 5, 0.92); backdrop-filter: blur(6px); }
  .lightbox[open] { display: flex; align-items: center; justify-content: center; }
  .lightbox figure { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 14px; max-width: min(92vw, 1200px); }
  .lb-img { max-width: 100%; max-height: 78vh; border-radius: 12px; object-fit: contain; }
  figcaption { display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; padding: 0 16px; }
  .lb-cap { font-size: 0.98rem; }
  .lb-meta { display: flex; gap: 18px; font-size: 0.76rem; color: #9db0a5; }
  .lb-link { color: #6ff5a6; }
  .lb-close, .lb-nav { position: fixed; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: #fff; border-radius: 999px; width: 48px; height: 48px; font-size: 1.7rem; line-height: 1; cursor: pointer; display: grid; place-items: center; }
  .lb-close:hover, .lb-nav:hover { background: rgba(62, 240, 138, 0.25); }
  .lb-close { top: 18px; right: 18px; }
  .lb-prev { left: 18px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 18px; top: 50%; transform: translateY(-50%); }
  @media (max-width: 600px) { .lb-prev, .lb-next { top: auto; bottom: 18px; transform: none; } .lb-prev { left: calc(50% - 60px); } .lb-next { right: calc(50% - 60px); } .lb-img { max-height: 70vh; } }
</style>
