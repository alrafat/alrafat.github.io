---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---
<Base title={d.title} description={d.summary}>
  <header class="page-head">
    <div class="grid-bg"></div>
    <div class="container narrow">
      <a href="/projects" class="back mono reveal">← All projects</a>
      <h1 class="reveal">{d.title}</h1>
      <p class="reveal">{d.summary}</p>
      <div class="meta reveal">
        <span class="chip">{d.status}</span><span class="chip">{d.category}</span><span class="chip">{d.year}</span>
        {d.tags.map((t) => <span class="chip">{t}</span>)}
      </div>
      <div class="cta reveal">
        {d.url && <a href={d.url} target="_blank" rel="noopener" class="btn primary">Visit live site <Icon name="external" /></a>}
        {d.repo && <a href={d.repo} target="_blank" rel="noopener" class="btn"><Icon name="github" /> Source</a>}
      </div>
    </div>
  </header>
  <section class="section" style="padding-top:20px">
    <div class="container narrow">
      {d.image && <img class="shot reveal" src={d.image} alt={`Screenshot of ${d.title}`} />}
      <article class="prose reveal"><Content /></article>
    </div>
  </section>
</Base>
<style>
  .narrow { max-width: 820px; }
  .back { font-size: 0.82rem; color: var(--muted); }
  .back:hover { color: var(--accent); }
  .meta { display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .shot { border-radius: var(--radius); border: 1px solid var(--border); margin-bottom: 40px; }
  .prose { font-size: 1.04rem; }
  .prose :global(h2) { font-size: 1.5rem; margin: 40px 0 12px; }
  .prose :global(p), .prose :global(li) { color: var(--muted); }
  .prose :global(strong) { color: var(--text); }
  .prose :global(ul) { padding-left: 20px; }
  .prose :global(li) { margin: 6px 0; }
</style>
