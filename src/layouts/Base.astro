---
import '../styles/global.css';
import { site, nav } from '../data/site';
import Icon from '../components/Icon.astro';

interface Props { title?: string; description?: string }
const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} — Plant Science · MS/PhD Applicant`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(site.photo, Astro.site);
const sameAs = Object.values(site.links).filter(Boolean);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: Astro.site?.toString(),
  image: ogImage.toString(),
  description: `${site.role}. ${site.headline}.`,
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Sylhet Agricultural University' },
  knowsAbout: ['Plant physiology', 'Plant stress', 'Plant nutrient management', 'Controlled environment agriculture', 'Precision agriculture'],
  address: { '@type': 'PostalAddress', addressLocality: 'Dhaka', addressCountry: 'BD' },
  sameAs,
};
const socials = [
  ['linkedin', 'LinkedIn'], ['scholar', 'Google Scholar'], ['orcid', 'ORCID'],
  ['researchgate', 'ResearchGate'], ['github', 'GitHub'], ['flickr', 'Flickr'], ['behance', 'Portfolio'],
].filter(([k]) => (site.links as Record<string, string>)[k]);
---
<!doctype html>
<html lang="en" class="no-js">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="author" content={site.name} />
  <meta property="og:type" content="profile" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  <meta name="theme-color" content="#070b09" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
  <script is:inline>
    document.documentElement.classList.remove('no-js');
    try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a href="#main" class="sr-only">Skip to content</a>
  <header class="nav" id="nav">
    <div class="container nav-inner">
      <a href="/" class="brand" aria-label="Home">
        <span class="mark">{site.initials}</span>
        <span class="brand-name">{site.name}</span>
      </a>
      <nav aria-label="Main">
        <ul class="links" id="navlinks">
          {nav.map((n) => (
            <li><a href={n.href} class:list={[{ active: n.href === '/' ? path === '/' : path.startsWith(n.href) }]}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
      <div class="nav-actions">
        <button class="icon-btn" id="theme" aria-label="Toggle light and dark theme">
          <span class="sun"><Icon name="sun" /></span><span class="moon"><Icon name="moon" /></span>
        </button>
        <a class="btn primary nav-cta" href={`mailto:${site.email}`}>Contact</a>
        <button class="icon-btn menu-btn" id="menu" aria-label="Open menu" aria-expanded="false" aria-controls="navlinks">
          <Icon name="menu" />
        </button>
      </div>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="footer">
    <div class="container footer-inner">
      <div>
        <div class="brand"><span class="mark">{site.initials}</span><span class="brand-name">{site.name}</span></div>
        <p class="muted small">{site.location}</p>
      </div>
      <div class="footer-links">
        <a href={`mailto:${site.email}`} aria-label="Email"><Icon name="mail" /></a>
        {socials.map(([k, label]) => (
          <a href={(site.links as Record<string, string>)[k]} target="_blank" rel="noopener" aria-label={label}><Icon name={k} /></a>
        ))}
        <a href={site.cv} download aria-label="Download CV"><Icon name="download" /></a>
      </div>
    </div>
    <div class="container"><p class="copy mono">© {new Date().getFullYear()} {site.name}</p></div>
  </footer>

  <script is:inline>
    // reveal on scroll
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    // nav shadow
    const nav = document.getElementById('nav');
    const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 10);
    onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
    // theme
    document.getElementById('theme').addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
    // mobile menu
    const menu = document.getElementById('menu');
    menu.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      menu.setAttribute('aria-expanded', String(open));
    });
  </script>
</body>
</html>

<style>
  .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 50; transition: background 0.3s, border-color 0.3s; border-bottom: 1px solid transparent; }
  .nav.scrolled, .nav.open { background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(14px); border-color: var(--border); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 72px; gap: 16px; }
  .brand { display: flex; align-items: center; gap: 12px; font-family: var(--font-display); font-weight: 600; }
  .mark { width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; font-size: 0.85rem; background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: var(--accent-ink); font-family: var(--font-mono); font-weight: 700; }
  .brand-name { font-size: 0.98rem; }
  .links { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .links a { padding: 8px 14px; border-radius: 999px; font-size: 0.92rem; color: var(--muted); transition: color 0.2s, background 0.2s; }
  .links a:hover { color: var(--text); }
  .links a.active { color: var(--text); background: var(--surface-2); }
  .nav-actions { display: flex; align-items: center; gap: 10px; }
  .nav-cta { padding: 9px 18px; font-size: 0.88rem; }
  .icon-btn { width: 40px; height: 40px; border-radius: 999px; display: grid; place-items: center; background: transparent; border: 1px solid var(--border); color: var(--muted); cursor: pointer; }
  .icon-btn:hover { color: var(--accent); border-color: var(--border-strong); }
  .sun { display: none; }
  .moon { display: block; }
  :global(:root[data-theme='light']) .sun { display: block; }
  :global(:root[data-theme='light']) .moon { display: none; }
  .menu-btn { display: none; }
  @media (max-width: 1080px) {
    .brand-name { display: none; }
  }
  @media (max-width: 760px) {
    .menu-btn { display: grid; }
    .nav-cta { display: none; }
    .links { position: absolute; top: 72px; left: 0; right: 0; flex-direction: column; padding: 8px 16px 20px; background: var(--bg); border-bottom: 1px solid var(--border); display: none; }
    .nav.open .links { display: flex; }
    .links a { display: block; padding: 12px 14px; font-size: 1rem; }
    .brand-name { display: inline; }
  }
  .footer { border-top: 1px solid var(--border); padding: 48px 0 28px; margin-top: 40px; }
  .footer-inner { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .footer .small { font-size: 0.88rem; margin: 10px 0 0; }
  .footer-links { display: flex; gap: 8px; }
  .footer-links a { width: 42px; height: 42px; border-radius: 999px; display: grid; place-items: center; border: 1px solid var(--border); color: var(--muted); transition: all 0.2s; }
  .footer-links a:hover { color: var(--accent); border-color: var(--accent); }
  .copy { font-size: 0.75rem; color: var(--faint); margin: 32px 0 0; }
</style>
